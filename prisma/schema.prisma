generator client {
  provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  WAREHOUSE
}

model Company {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  logo          String?   // لحفظ الصورة
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  
  users         User[]
  products      Product[] // <--- تمت الإضافة
  sales         Sale[]    // <--- تمت الإضافة
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CASHIER)
  expiryDate DateTime?
  companyId String?  // <--- ربط المستخدم بالشركة
  company   Company? @relation(fields: [companyId], references: [id])
  
  // --- حقول الانتحال (الجديدة) ---
  impersonatedBy String?   // بريد السوبر أدمن الذي قام بالدخول
  isImpersonating Boolean @default(false) // هل الجلسة الحالية هي جلسة انتحال؟
  // ------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  auditLogs AuditLog[] // <--- سجل العمليات
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  companyId String?   // <--- ربط المورد بالشركة (اختياري)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                String    @id @default(cuid())
  name              String
  imageUrl          String?
  barcode           String?   @unique
  category          String?
  price             Float
  cost              Float
  stock             Int       @default(0)
  lowStockThreshold Int       @default(10)
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  companyId         String?   // <--- ربط المنتج بالشركة
  company           Company?  @relation(fields: [companyId], references: [id])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  saleItems         SaleItem[]
}

model Sale {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  subtotal      Float
  tax           Float      @default(0)
  discount      Float      @default(0)
  total         Float
  paymentMethod String     @default("CASH")
  isReturned    Boolean    @default(false)
  companyId     String?    // <--- ربط الفاتورة بالشركة
  company       Company?   @relation(fields: [companyId], references: [id])
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  @@index([saleId])
  @@index([productId])
}

model StoreSettings {
  id        String   @id @default("global_settings")
  storeName String   @default("متجري")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // نوع العملية (CREATE, UPDATE, DELETE, SALE, RETURN)
  entity    String   // اسم الجدول (Product, User, Sale, Company)
  entityId  String?  // معرف العنصر الذي تم التعديل عليه
  details   String?  // تفاصيل إضافية (مثلاً: "تغيير السعر من 10 إلى 15")
  userId    String?  // من قام بالعملية
  user      User?    @relation(fields: [userId], references: [id])
  companyId String?  // الشركة التابع لها
  createdAt DateTime @default(now())
}